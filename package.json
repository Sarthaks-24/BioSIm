{
  "name": "lifepeek",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lifepeek/web",
    "dev:api": "npm run dev -w @lifepeek/api",
    "build": "npm run build -w @lifepeek/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run validate -w @lifepeek/engine",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:dead": "node apps/web/scripts/dead-code.mjs",
    "check": "npm run validate && npm run format:check && npm run lint:dead && npm run typecheck && npm run test && npm run build",
    "release-gate": "node apps/web/scripts/release-gate.mjs"
  },
  "devDependencies": {
    "prettier": "^3.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}

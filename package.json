{
  "name": "biosim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @biosim/web",
    "dev:api": "npm run dev -w @biosim/api",
    "build": "npm run build -w @biosim/engine && npm run build -w @biosim/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate": "npm run validate -w @biosim/engine",
    "check": "npm run validate && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  }
}

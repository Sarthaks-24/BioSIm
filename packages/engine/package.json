{
  "name": "@lifepeek/engine",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "description": "Pure TypeScript digestion model: food schema, gastric emptying, gut transit, glucose band.",
  "exports": {
    ".": "./src/index.ts",
    "./run": "./src/run.ts",
    "./catalog/core": "./src/core/catalog/core.ts",
    "./catalog/breathing": "./src/core/catalog/breathing.ts",
    "./catalog/circulation": "./src/core/catalog/circulation.ts",
    "./catalog/kidneys": "./src/core/catalog/kidneys.ts"
  },
  "scripts": {
    "test": "vitest run --exclude test/perf.test.ts && vitest run test/perf.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-foods.ts",
    "calibrate": "tsx scripts/calibrate.ts"
  },
  "dependencies": {
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "@types/node": "^24.0.0"
  }
}

{
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw.js|workbox-|manifest.webmanifest|favicon|icon-|THIRD_PARTY_NOTICES|robots.txt|sitemap.xml|stats.json).*)",
      "destination": "/index.html"
    }
  ]
}

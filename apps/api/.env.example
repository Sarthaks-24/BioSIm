# Copy to apps/api/.env — `npm run dev:api` / `npm start -w @biosim/api` load it automatically.

# Local SQLite file, or a Turso/libSQL URL in production (libsql://...)
DATABASE_URL=file:biosim.db
DATABASE_AUTH_TOKEN=
# Comma-separated origins allowed to call the API from a browser (your web app's URL)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Bearer token for GET /api/feedback (leave empty to disable reading reports)
ADMIN_TOKEN=
# Set to 1 ONLY if a proxy you control (e.g. Render, Fly, Nginx) sets X-Forwarded-For
TRUST_PROXY=
PORT=8787

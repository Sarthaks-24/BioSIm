# Leave empty in production: reports open as a GitHub issue and nothing is sent. Local API: set VITE_API_URL=/api in .env.development.local (the dev server proxies it).
VITE_API_URL=

# Where "report a mistake" opens a GitHub issue (default: the LifePeek repository).
VITE_ISSUES_URL=

# The site's address (canonical links, link previews, sitemap, the Teach QR code). Set it in the
# Vercel project's environment once the real name is known; empty = https://lifepeek.vercel.app.
VITE_SITE_URL=
